# Optional non-secret provider/model overrides. This file is loaded by local
# commands and Compose; uncomment and configure only values supported by the
# selected Hermes runtime. Keep API keys and OAuth state in protected runtime
# storage, never in this file.
# LLM_ASSISTANT_PROVIDER=example-provider
# LLM_ASSISTANT_MODEL_SMALL=example-small-model
# LLM_ASSISTANT_MODEL_MEDIUM=example-balanced-model
# LLM_ASSISTANT_MODEL_HIGH=example-large-model
